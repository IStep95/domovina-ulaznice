{
  // domovina-ulaznice — javna prodaja ulaznica bez posrednika.
  //
  // Jedan Worker servira /api/* (Stripe rail + dostava ulaznica) i React SPA
  // (ASSETS binding). Ticketing jezgra NIJE ovdje — ona živi u domovina-api
  // (shema pinka_finance). D1 drži samo operativni trag: webhook log, poslane
  // e-mailove i brand postavke prodajne stranice. Ulaznica, narudžbi i
  // inventoryja u D1 NEMA i ne smije biti (docs/02-arhitektura.md §1).
  //
  // ── DVA OKRUŽENJA ─────────────────────────────────────────────────────────
  //
  //   vrh datoteke  → PRODUKCIJA   ulaznice.domovina.ai
  //   env.staging   → STAGING      ulaznice-staging.domovina.ai
  //
  //   wrangler deploy                  → produkcija (puna aplikacija)
  //   wrangler deploy --env staging    → staging (puna aplikacija)
  //
  // Do 2026-11-23 produkcija je bila samo najava (var NAJAVA=1: statična stranica,
  // /api/* i /webhook/* → 404, bez ASSETS/D1/KV/crona). Ivan ju je tada otvorio
  // istim bindinzima kao staging. Prodaja radi tek kad su postavljene tajne
  // (v. dno); do tada /api/zdravlje javlja stripe/hmac/mail: false.
  // Za povratak na najavu: "NAJAVA": "1" u vars i deploy.
  //
  // Oba okruženja gađaju ISTU jezgru (api.domovina.ai) — to je odluka vlasnika,
  // ne propust: jezgra je backend-only i jednog dana drži i stvarno plaćene i
  // staging ulaznice jedne pored drugih. Staging Worker je "samo frontend".
  // Posljedica koju treba poštovati: narudžbe iz staginga stvaraju stvarne
  // retke u pinka_finance, pa test organizator ima fiksne, prepoznatljive
  // UUID-eve da se može čisto obrisati (v. seeds/).
  "name": "domovina-ulaznice",
  "main": "worker/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // ── PRODUKCIJA: puna aplikacija (od 2026-11-23, Ivan) ──────────────────────
  // Isto kao env.staging, s produkcijskim D1/KV/WEB. Za najavu vrati "NAJAVA": "1".
  "routes": [
    { "pattern": "ulaznice.domovina.ai", "custom_domain": true }
  ],
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "domovina-ulaznice",
      "database_id": "2c01251e-133a-42db-9d1e-70cfe47db223"
    }
  ],
  "kv_namespaces": [
    { "binding": "RL", "id": "e138b49a3eb14b56b1bbb8f57cde1c66" }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "services": [
    { "binding": "WEB", "service": "domovina-ulaznice-web" }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://ulaznice.domovina.ai",
    "DOMOVINA_API_URL": "https://api.domovina.ai",
    // Anon ključ nije tajna (v. env.staging).
    "DOMOVINA_API_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsImlhdCI6MTc3OTExMTcxMywiZXhwIjo0OTMyNzExNzEzLCJyb2xlIjoiYW5vbiJ9.Q4Ef7xMc2dmjMyfJebPDyqNirnARZzMxTWe7i0dASPI",
    "APPLE_APP_IDS": "6SCK58757K.ai.domovina.ulaznice",
    "ANDROID_CERT_SHA256": "",
    "EMAIL_FROM": "Domovina ulaznice <ulaznice@domovina.ai>",
    "EMAIL_REPLY_TO": "podrska@domovina.ai",
    "ALARM_EMAIL": "podrska@domovina.ai",
    "ALARM_PRIGUSI_MIN": "180",
    "RL_ORDER_IP": "10/600",
    "RL_WEBHOOK_IP": "300/60"
  },

  "env": {
    // ── STAGING: puna aplikacija ────────────────────────────────────────────
    // Bindingi se u wrangleru NE nasljeđuju iz vrha — sve se navodi ponovno.
    "staging": {
      "name": "domovina-ulaznice-staging",
      "routes": [
        { "pattern": "ulaznice-staging.domovina.ai", "custom_domain": true }
      ],
      "workers_dev": true,
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        // Worker prije statike (S6). Bez ovoga Cloudflare `/` i `/index.html`
        // servira ravno iz dist/ (index.html SPA-e) i Worker — pa ni binding WEB —
        // uopće ne vidi početnu stranicu kupca (izmjereno u wrangler devu:
        // `/` je dao SPA, `/favicon.svg` je otišao na WEB). Statika SPA-e ide
        // eksplicitno kroz env.ASSETS.fetch u worker/index.ts. Wrangler 3 zna
        // samo boolean; popis uzoraka traži wrangler 4.
        "run_worker_first": true
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "domovina-ulaznice-staging",
          "database_id": "f9c7a381-d75e-4a74-9ddc-62482313d875"
        }
      ],
      "kv_namespaces": [
        // efemerni brojači (rate limit). Ništa domensko.
        { "binding": "RL", "id": "2ea2e4ca9048414faa78a9be870722aa" }
      ],
      "triggers": {
        // rekoncilijacija: nesparene uplate, propušteni webhookovi, istekli holdovi
        "crons": ["*/15 * * * *"]
      },
      // Astro frontend za kupce (web/, S6): /, /dogadjaj/*, /ulaznice/*, /uvjeti,
      // /privatnost i Astrova statika idu na WEB; /api, /webhook, /.well-known,
      // /organizator, /skener i /assets/* (SPA) ostaju ovdje — idePremaWebu() u
      // worker/index.ts. Bez ovog bindinga Worker radi kao prije (sve iz ASSETS).
      // Deploy: PRVO web (npm --prefix web run deploy:staging), pa ovaj Worker —
      // inače binding gađa servis kojeg nema i stranice kupaca ne rade. Lokalno
      // `wrangler dev` traži servis istog imena u dev registryju.
      "services": [
        { "binding": "WEB", "service": "domovina-ulaznice-web-staging" }
      ],
      "vars": {
        "PUBLIC_BASE_URL": "https://ulaznice-staging.domovina.ai",
        "DOMOVINA_API_URL": "https://api.domovina.ai",
        // Anon ključ GoTruea. NIJE tajna: po dizajnu putuje u svakom browser
        // bundleu Supabase aplikacije, i isti ključ stoji u
        // domovina-fiskal/backend/wrangler.toml uz istu napomenu. Bez njega
        // prijava organizatora i skener ulaza ne rade. Tajna je i ostaje samo
        // service ključ (wrangler secret) i HS256 JWT_SECRET (nikad ovdje).
        "DOMOVINA_API_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsImlhdCI6MTc3OTExMTcxMywiZXhwIjo0OTMyNzExNzEzLCJyb2xlIjoiYW5vbiJ9.Q4Ef7xMc2dmjMyfJebPDyqNirnARZzMxTWe7i0dASPI",
        // Mobilne aplikacije (mobile/): Universal Links (iOS) i App Links (Android)
        // za /ulaznice/<id>. Team ID je ITalk (isti kao domovina-browser);
        // Android otisak dodati kad postoji release potpis (mobile/README.md).
        "APPLE_APP_IDS": "6SCK58757K.ai.domovina.ulaznice",
        "ANDROID_CERT_SHA256": "",
        "EMAIL_FROM": "Domovina ulaznice (staging) <ulaznice@domovina.ai>",
        "EMAIL_REPLY_TO": "podrska@domovina.ai",
        // Kamo idu alarmi rekoncilijacije i zaostale dostave. Bez ove adrese
        // alarm završi u console.error koji nitko ne gleda.
        "ALARM_EMAIL": "podrska@domovina.ai",
        // koliko minuta isti alarm šuti nakon slanja (cron ide svakih 15 min)
        "ALARM_PRIGUSI_MIN": "180",
        // rate limit "koliko/sekundi" (worker/ratelimit.ts); prazno = zadano
        "RL_ORDER_IP": "10/600",
        "RL_WEBHOOK_IP": "300/60"
      }
    }
  }

  // Tajne su PO OKRUŽENJU — staging ključ ne može završiti u produkciji:
  //   wrangler secret put <IME> --env staging
  //
  //   STRIPE_SECRET_KEY             sk_test_… (staging = Stripe sandbox)
  //   STRIPE_WEBHOOK_SECRET         whsec_… (Connect endpoint!)
  //   EVENTS_STRIPE_CONFIRM_SECRET  ISTA vrijednost kao u domovina-api edge runtimeu
  //   DOMOVINA_API_SERVICE_KEY      service_role ključ (nikad u SPA)
  //   RESEND_API_KEY                bez njega mail ide u log, ne šalje se
  //   FIRA_API_KEY                  ključ organizatora; bez njega račun ostaje
  //                                 obveza organizatora (provider 'organizator')
}
