---
// Blok organizatora (Dogadjaj-1280 lijevi stupac, Dogadjaj-390 dno): avatar s
// inicijalima u naglasnoj boji, ime, e-mail, web i uvjeti organizatora.
// URL-ovi dolaze već provjereni (sigurniUrl u src/lib/format.ts).
import Ikona from "./Ikona.astro";
import { inicijali, prikazUrla } from "../lib/format.ts";

interface Props {
  ime: string;
  email?: string | null;
  web?: string | null;
  uvjeti?: string | null;
}

const { ime, email, web, uvjeti } = Astro.props;
---
<div class="organizator">
  <div class="ime">
    <span class="avatar" aria-hidden="true">{inicijali(ime)}</span>
    <b>{ime}</b>
  </div>
  {
    email && (
      <a class="link" href={`mailto:${email}`}>
        <Ikona ime="email" velicina={16} />
        {email}
      </a>
    )
  }
  {
    web && (
      <a class="link" href={web} rel="noopener">
        <Ikona ime="vanjski" velicina={16} />
        {prikazUrla(web)}
      </a>
    )
  }
  {
    uvjeti && (
      <a class="link" href={uvjeti} rel="noopener">
        <Ikona ime="vanjski" velicina={16} />
        Uvjeti organizatora
      </a>
    )
  }
</div>

<style>
  .organizator {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .ime {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: var(--space-1);
    font-size: 15px;
  }
  .avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-size: 13px;
    font-weight: 700;
  }
  .link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-min);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    overflow-wrap: anywhere;
  }
</style>
