---
// Odjeljak stranice događaja s malim naslovom i crtom ispod (Dogadjaj-1280:
// „O događaju”, „Lokacija”, „Organizator”, „Dodaj u kalendar”).
interface Props {
  naslov: string;
  /** id naslova; odjeljak dobiva aria-labelledby. */
  id: string;
  class?: string;
}

const { naslov, id, class: klasa } = Astro.props;
---
<section class:list={["odjeljak", klasa]} aria-labelledby={id}>
  <h2 id={id} class="naslov">{naslov}</h2>
  <slot />
</section>

<style>
  .odjeljak {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .naslov {
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text-muted);
  }
  @media (max-width: 719px) {
    .odjeljak {
      gap: 10px;
    }
  }
</style>
