---
// Red vrste ulaznice u cjeniku (Main.dc.html „Redovi tiera”, Dogadjaj-1280).
// Stanja:
//   dostupno    — naziv, opis, cijena
//   malo        — + oznaka „još N” (ok)
//   rasprodano  — prigušeno, „rasprodano” (error), precrtana cijena
//   nije-pocelo — prigušeno, „prodaja od …” (wait) s datumom početka
//   zavrseno    — prigušeno, „prodaja zatvorena” (neutral)
// Prigušeni red mijenja pozadinu i boju teksta, nikad opacity (pravilo 3).
// Stanje iz TierView računa stanjeTiera() u src/lib/format.ts.
import Oznaka from "./Oznaka.astro";
import { eur, type StanjeTiera } from "../lib/format.ts";

interface Props {
  naziv: string;
  opis?: string | null;
  cijenaCenti: number;
  /** `imenska`: dodaje „· glasi na ime” u opis (odstupanje od briefa, README). */
  imenska?: boolean;
  stanje?: StanjeTiera;
  /** Za „malo”: broj preostalih (`available`). */
  preostalo?: number | null;
  /** Za „nije-pocelo”: gotov tekst, npr. „1. 3. 2027. u 10:00” (kratkiDatum). */
  prodajaOd?: string;
}

const { naziv, opis, cijenaCenti, imenska = false, stanje = "dostupno", preostalo, prodajaOd } = Astro.props;
const prigusen = stanje === "rasprodano" || stanje === "nije-pocelo" || stanje === "zavrseno";
const punOpis = [opis, imenska ? "glasi na ime" : null].filter(Boolean).join(" · ");
---
<div class:list={["red", { prigusen }]}>
  <div class="tekst">
    <span class="naziv">{naziv}</span>
    {!prigusen && punOpis && <span class="opis">{punOpis}</span>}
    {stanje === "malo" && preostalo != null && <Oznaka ton="ok">još {preostalo}</Oznaka>}
    {stanje === "rasprodano" && <Oznaka ton="error">rasprodano</Oznaka>}
    {stanje === "nije-pocelo" && <Oznaka ton="wait">{prodajaOd ? `prodaja od ${prodajaOd}` : "prodaja još nije počela"}</Oznaka>}
    {stanje === "zavrseno" && <Oznaka ton="neutral">prodaja zatvorena</Oznaka>}
  </div>
  {
    stanje === "rasprodano" ? (
      <span class="cijena">
        <del>{eur(cijenaCenti)}</del>
      </span>
    ) : (
      <span class="cijena">{eur(cijenaCenti)}</span>
    )
  }
</div>

<style>
  .red {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) 18px;
    border-bottom: 1px solid var(--color-border);
  }
  .red:last-child {
    border-bottom: 0;
  }
  .tekst {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    min-width: 0;
  }
  .naziv {
    font-size: var(--font-size-md);
    font-weight: 600;
  }
  .opis {
    margin-top: -2px;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }
  .cijena {
    flex: none;
    font-size: var(--font-size-md);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .cijena del {
    text-decoration-thickness: 1px;
  }

  .prigusen {
    background: var(--color-surface-2);
  }
  .prigusen .naziv,
  .prigusen .cijena {
    color: var(--color-text-muted);
  }
  .prigusen .cijena {
    font-weight: 600;
  }

  @media (max-width: 719px) {
    .red {
      gap: var(--space-3);
      padding: 14px var(--space-4);
    }
  }
</style>
