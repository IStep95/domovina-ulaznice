---
// Kartica „Ulaznice” na stranici događaja (Dogadjaj-1280/390): zaglavlje,
// redovi (RedTiera u zadanom slotu) i dno s gumbom „Kupi ulaznice” (slot "dno").
interface Props {
  naslov?: string;
  /** id naslova za aria-labelledby; jedinstven na stranici. */
  id?: string;
}

const { naslov = "Ulaznice", id = "ulaznice" } = Astro.props;
---
<section class="cjenik" aria-labelledby={id}>
  <h2 id={id} class="zaglavlje">{naslov}</h2>
  <div class="redovi"><slot /></div>
  {Astro.slots.has("dno") && <div class="dno"><slot name="dno" /></div>}
</section>

<style>
  .cjenik {
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }
  .zaglavlje {
    padding: var(--space-3) 18px;
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text-muted);
    background: var(--color-surface-2);
    border-bottom: 1px solid var(--color-border);
  }
  .dno {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px;
    border-top: 1px solid var(--color-border);
    font-size: 13px;
    text-align: center;
    color: var(--color-text-muted);
  }
  @media (max-width: 719px) {
    .zaglavlje {
      padding: 11px var(--space-4);
    }
  }
</style>
