---
// Opis događaja: HTML koji je već iscrtao i sanitizirao src/lib/opis.ts
// (odluka 19, 302). Ova komponenta ga samo umeće i stilizira; ne prima ništa drugo.
interface Props {
  html: string;
}

const { html } = Astro.props;
---
<div class="proza" set:html={html} />

<style>
  .proza {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 640px;
    font-size: var(--font-size-md);
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .proza :global(h3),
  .proza :global(h4),
  .proza :global(h5),
  .proza :global(h6) {
    margin-top: 6px;
    font-size: var(--font-size-lg);
    font-weight: 700;
    line-height: 1.3;
  }
  .proza :global(h4),
  .proza :global(h5),
  .proza :global(h6) {
    font-size: var(--font-size-md);
  }
  .proza :global(ul),
  .proza :global(ol) {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-left: 20px;
  }
  .proza :global(a) {
    color: var(--color-text);
    text-underline-offset: 3px;
  }
  .proza :global(a:hover) {
    color: var(--color-accent-text);
  }
  .proza :global(blockquote) {
    padding-left: var(--space-4);
    border-left: 3px solid var(--color-border-strong);
    color: var(--color-text-muted);
  }
  .proza :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-border);
  }
  .proza :global(code) {
    font-size: 0.92em;
  }
  @media (max-width: 719px) {
    .proza {
      gap: 10px;
    }
    .proza :global(h3) {
      font-size: 17px;
    }
  }
</style>
