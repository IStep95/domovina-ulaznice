---
// Zaglavlje svih stranica za kupce (Popis-1280, Dogadjaj-1280/390): logo
// „Ulaznice” i navigacija. Platformsko: bez naglasne boje organizatora.
import Ikona from "./Ikona.astro";
---
<header class="zaglavlje">
  <a class="logo" href="/">
    <Ikona ime="logo" velicina={22} />
    Ulaznice
  </a>
  <nav class="nav" aria-label="Glavna navigacija">
    <a href="/">Događaji</a>
    <a class="sporedno" href="/uvjeti">Uvjeti</a>
  </nav>
</header>

<style>
  .zaglavlje {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 14px var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }
  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-min);
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 20px;
    font-size: var(--font-size-sm);
    font-weight: 500;
  }
  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    text-decoration: none;
  }
  .nav a:hover {
    text-decoration: underline;
  }
  .nav .sporedno {
    color: var(--color-text-muted);
  }
  @media (max-width: 719px) {
    .zaglavlje {
      padding: var(--space-3) var(--space-4);
    }
    .logo {
      font-size: var(--font-size-md);
    }
    .nav .sporedno {
      display: none;
    }
  }
</style>
