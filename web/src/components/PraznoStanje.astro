---
// Prazno stanje (Popis-1280: „Trenutačno nema objavljenih događaja.”).
// Isprekidani obrub, centrirano; slot za eventualnu akciju.
interface Props {
  naslov: string;
  opis?: string;
}

const { naslov, opis } = Astro.props;
---
<div class="prazno">
  <b class="naslov">{naslov}</b>
  {opis && <span class="opis">{opis}</span>}
  <slot />
</div>

<style>
  .prazno {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 28px;
    text-align: center;
    border: 1.5px dashed var(--color-border-strong);
    border-radius: var(--radius-lg);
  }
  .naslov {
    font-size: 17px;
  }
  .opis {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }
</style>
