---
// Red termina ili mjesta ispod naslova događaja (Dogadjaj-1280/390): lijevo
// pločica (slot "znak": DatumskaPlocica ili ikona u okviru), desno podebljani
// glavni redak i prigušeni drugi redak.
import Ikona from "./Ikona.astro";
import type { IkonaIme } from "../lib/ikone.ts";

interface Props {
  glavno: string;
  sporedno?: string | null;
  /** Ikona u okviru 48 px kad nema slota "znak". */
  ikona?: IkonaIme;
}

const { glavno, sporedno, ikona } = Astro.props;
---
<div class="red">
  {
    Astro.slots.has("znak") ? (
      <slot name="znak" />
    ) : (
      <span class="okvir" aria-hidden="true">
        <Ikona ime={ikona ?? "info"} velicina={22} />
      </span>
    )
  }
  <div class="tekst">
    <b class="glavno">{glavno}</b>
    {sporedno && <span class="sporedno">{sporedno}</span>}
  </div>
</div>

<style>
  .red {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .okvir {
    flex: none;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .tekst {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .glavno {
    font-size: var(--font-size-md);
  }
  .sporedno {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }
  @media (max-width: 719px) {
    .red {
      gap: var(--space-3);
    }
    .okvir {
      width: 44px;
      height: 44px;
    }
    .glavno {
      font-size: 15px;
    }
  }
</style>
