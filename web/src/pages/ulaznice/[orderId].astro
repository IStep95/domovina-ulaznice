---
// Narudžba (S5; Narudzba-1280, Narudzba-390, Narudzba-stanja-1280). Link iz
// e-maila i povratak sa Stripea (`?placeno=1`). `order_id` (128-bit random) je
// jedini ključ, bez prijave. SSR iz GET /api/ulaznice/:id; ponašanje prati
// src/pages/Narudzba.tsx (bivši SPA, obrisan u S7):
//   pending + ?placeno=1 → otok PotvrdaPlacanja provjerava svake 2 s (do 20 s) i
//                          ponovno učita stranicu kad stanje više nije pending
//   paid                 → popis ulaznica, ponovna dostava (otok), link u aplikaciju
//   expired / failed     → „Natrag na događaj”; refunded → poništene ulaznice
// QR se ovdje namjerno ne prikazuje: jednokratan je i živi u e-mailu i u
// aplikaciji (design-brief §4.4, §9; odluka 501).
//
// Cache: no-store za sve (CACHE_NARUDZBA), i noindex: URL je ključ narudžbe.
// Neispravan id i nepostojeća narudžba → 404 („Narudžba nije pronađena.”),
// ostale greške API-ja → 503 s „Pokušaj ponovno”.
import { ApiError, type OrderView } from "../../lib/api.ts";
import { serverApi } from "../../lib/api-ssr.ts";
import Osnovni from "../../layouts/Osnovni.astro";
import Banner from "../../components/Banner.astro";
import DatumskaPlocica from "../../components/DatumskaPlocica.astro";
import Gumb from "../../components/Gumb.astro";
import PonovnaDostava from "../../components/PonovnaDostava.tsx";
import PotvrdaPlacanja from "../../components/PotvrdaPlacanja.tsx";
import RedUlaznice from "../../components/RedUlaznice.astro";
import StranicaGreske from "../../components/StranicaGreske.astro";
import ZaglavljeNarudzbe from "../../components/ZaglavljeNarudzbe.astro";
import { ZADANA_ZONA, eur, rokRezervacije, terminJednimRetkom } from "../../lib/format.ts";
import {
  cekaPotvrdu,
  ispravanOrderId,
  linkAplikacije,
  placenoIzUrla,
  stanjeUlaznice,
  stanjeZaglavlja,
} from "../../lib/narudzba.ts";
import { CACHE_NARUDZBA } from "../../lib/stranica.ts";

const orderId = Astro.params.orderId ?? "";
let narudzba: OrderView | null = null;
let greska: "nije-pronadena" | "server" | null = null;
if (!ispravanOrderId(orderId)) greska = "nije-pronadena";
else {
  try {
    narudzba = await serverApi().dohvatiNarudzbu(orderId);
  } catch (e) {
    if (e instanceof ApiError && (e.status === 404 || e.code === "invalid_order_id")) greska = "nije-pronadena";
    else {
      console.error("dohvatiNarudzbu", orderId, e);
      greska = "server";
    }
  }
}

if (greska === "nije-pronadena") Astro.response.status = 404;
if (greska === "server") Astro.response.status = 503;
Astro.response.headers.set("cache-control", CACHE_NARUDZBA);

const placeno = placenoIzUrla(Astro.url.searchParams);
const ev = narudzba?.event ?? null;
const zona = ev?.timezone || ZADANA_ZONA;
const stanje = narudzba ? stanjeZaglavlja(narudzba.state, placeno) : "pending";
const ceka = narudzba ? cekaPotvrdu(narudzba.state, placeno) : false;
const placena = narudzba?.state === "paid";
const naDogadjaj = ev?.slug ? `/dogadjaj/${encodeURIComponent(ev.slug)}` : null;
const mjesto = [ev?.venue_name, ev?.venue_city].filter(Boolean).join(", ");
const rok = narudzba?.state === "pending" ? rokRezervacije(narudzba.expires_at, zona) : null;
---
{
  !narudzba ? (
    <Osnovni
      title={greska === "server" ? "Greška · Ulaznice" : "Narudžba nije pronađena · Ulaznice"}
      sirina="srednja"
      noindex
    >
      {greska === "server" ? (
        <StranicaGreske
          kod="500"
          naslov="Nešto je pošlo po zlu."
          opis="Pokušajte ponovno za trenutak. Ako se ponavlja, javite se na podrska@domovina.ai."
          ikona="upozorenje"
          ton="error"
        >
          <Gumb href={Astro.url.pathname + Astro.url.search}>Pokušaj ponovno</Gumb>
        </StranicaGreske>
      ) : (
        <StranicaGreske
          kod="404"
          naslov="Narudžba nije pronađena."
          opis="Provjerite link iz e-maila — mora biti cijeli, do zadnjeg znaka."
        >
          <Gumb varijanta="sekundarni" href="/">Na popis događaja</Gumb>
        </StranicaGreske>
      )}
    </Osnovni>
  ) : (
    <Osnovni
      title={`${ev?.title ? `${ev.title} · ` : ""}Narudžba · Ulaznice`}
      opis="Stanje narudžbe i ulaznice."
      sirina="uska"
      noindex
    >
      {/* Bez JavaScripta otok ne radi; preglednik sam osvježava dok se čeka webhook. */}
      {ceka && (
        <noscript slot="head">
          <meta http-equiv="refresh" content="5" />
        </noscript>
      )}

      <div class="narudzba">
        <ZaglavljeNarudzbe stanje={stanje}>
          {stanje === "pending" && rok && <span>Rezervacija vrijedi do {rok}</span>}
          {(stanje === "expired" || stanje === "failed") && naDogadjaj && <Gumb href={naDogadjaj}>Natrag na događaj</Gumb>}
        </ZaglavljeNarudzbe>

        {ceka && <PotvrdaPlacanja client:load orderId={narudzba.order_id} />}

        <section class="kartica sazetak" aria-label="Sažetak narudžbe">
          <div class="dogadjaj">
            <DatumskaPlocica datum={ev?.starts_at} timeZone={zona} varijanta="boja" velicina="m" ukras />
            <div class="dogadjaj-tekst">
              {naDogadjaj ? (
                <a class="naslov" href={naDogadjaj}>{ev?.title}</a>
              ) : (
                <b class="naslov">{ev?.title ?? "Narudžba"}</b>
              )}
              {ev && <span class="meta">{terminJednimRetkom(ev.starts_at, ev.ends_at, zona)}</span>}
              {mjesto && <span class="meta">{mjesto}</span>}
            </div>
          </div>
          <dl class="brojke">
            <dt>Ulaznica</dt>
            <dd>{narudzba.quantity}</dd>
            <dt>{placena ? "Plaćeno" : "Iznos"}</dt>
            <dd>{eur(narudzba.amount_cents)}</dd>
            {narudzba.buyer_email && (
              <>
                <dt>E-mail</dt>
                <dd>{narudzba.buyer_email}</dd>
              </>
            )}
            {rok && (
              <>
                <dt>Rezervacija vrijedi do</dt>
                <dd>{rok}</dd>
              </>
            )}
          </dl>
        </section>

        {
          narudzba.tickets.length > 0 && (
            <>
              <section class="kartica ulaznice" aria-labelledby="ulaznice-naslov">
                <h2 id="ulaznice-naslov">Ulaznice</h2>
                {narudzba.tickets.map((t) => (
                  <RedUlaznice ime={t.holder_name} serijski={t.serial} stanje={stanjeUlaznice(t.state)} />
                ))}
              </section>
              <p class="napomena">QR kodovi se ovdje namjerno ne prikazuju: jednokratni su i stižu samo e-mailom i u aplikaciji.</p>
            </>
          )
        }

        {
          placena && (
            <section class="kartica dostava" aria-labelledby="dostava-naslov">
              <h2 id="dostava-naslov">Niste dobili e-mail?</h2>
              <p class="tekst">Provjerite mapu neželjene pošte. Ako poruke nema, pošaljite je ponovno.</p>
              {/* Posljedica se kaže PRIJE klika: rotacija poništava stari QR, a netko
                  ga je možda već proslijedio. */}
              <Banner ton="wait" uloga="note" ikona="upozorenje">
                Ako je prva poruka stigla, novi QR kodovi poništavaju stare — proslijeđene ulaznice iz stare poruke
                prestaju vrijediti.
              </Banner>
              <PonovnaDostava client:load orderId={narudzba.order_id} />
            </section>
          )
        }

        <section class="link">
          <div class="link-tekst">
            <b>Sačuvajte ovaj link</b>
            <span>Njime pristupate narudžbi bez prijave.</span>
            {
              placena && (
                <span>
                  Imate aplikaciju Ulaznice? Prijenos u aplikaciju izdaje nove QR kodove ako su prvi već poslani, pa oni
                  iz e-maila tada prestaju vrijediti.
                </span>
              )
            }
          </div>
          {placena && <Gumb href={linkAplikacije(narudzba.order_id)}>Otvorite narudžbu u aplikaciji</Gumb>}
        </section>
      </div>
    </Osnovni>
  )
}

<style>
  .narudzba {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .kartica {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  /* Sažetak: pločica, događaj, brojke desno (Narudzba-1280). */
  .sazetak {
    display: flex;
    gap: 18px;
    padding: 20px;
  }
  .dogadjaj {
    flex: 1;
    display: flex;
    gap: 18px;
    min-width: 0;
  }
  .dogadjaj-tekst {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }
  .naslov {
    font-size: 19px;
    font-weight: 700;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  a.naslov:hover {
    text-decoration: underline;
  }
  .meta {
    font-size: 15px;
    color: var(--color-text-muted);
  }
  .brojke {
    flex: none;
    display: grid;
    grid-template-columns: auto auto;
    gap: 6px var(--space-4);
    align-content: start;
    font-size: var(--font-size-sm);
    font-variant-numeric: tabular-nums;
  }
  .brojke dt {
    color: var(--color-text-muted);
  }
  .brojke dd {
    font-weight: 600;
    text-align: right;
    overflow-wrap: anywhere;
  }

  /* Ulaznice: zaglavlje kartice + redovi (RedUlaznice). */
  .ulaznice {
    overflow: hidden;
  }
  .ulaznice h2 {
    padding: var(--space-3) 18px;
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text-muted);
    background: var(--color-surface-2);
    border-bottom: 1px solid var(--color-border);
  }
  .napomena {
    margin-top: -8px;
    font-size: 13px;
    color: var(--color-text-muted);
  }

  /* Ponovna dostava. */
  .dostava {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 22px;
  }
  .dostava h2 {
    font-size: var(--font-size-lg);
    font-weight: 700;
  }
  .dostava .tekst {
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  /* „Sačuvajte ovaj link” + link u aplikaciju. */
  .link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 18px 20px;
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-lg);
  }
  .link-tekst {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }
  .link-tekst b {
    font-size: 15px;
    color: var(--color-text);
  }
  .link > :global(a) {
    flex: none;
  }

  /* Mobitel (Narudzba-390): jedan stupac, brojke ispod događaja. */
  @media (max-width: 719px) {
    .narudzba {
      gap: var(--space-4);
    }
    .sazetak {
      flex-direction: column;
      gap: var(--space-3);
      padding: var(--space-4);
    }
    .dogadjaj {
      gap: var(--space-3);
    }
    .naslov {
      font-size: var(--font-size-md);
    }
    .meta {
      font-size: var(--font-size-sm);
    }
    .brojke {
      grid-template-columns: 1fr auto;
      gap: var(--space-2);
      padding-top: var(--space-3);
      border-top: 1px solid var(--color-border);
    }
    .dostava {
      padding: 18px var(--space-4);
    }
    .link {
      flex-direction: column;
      align-items: flex-start;
      padding: 14px var(--space-4);
    }
    .link > :global(a) {
      white-space: normal;
    }
  }
</style>
