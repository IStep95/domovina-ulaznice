{
  "name": "domovina-ulaznice-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:mock": "node scripts/dev-mock.mjs",
    "e2e": "node scripts/e2e-cdp.mjs",
    "e2e:stack": "node scripts/e2e-cdp.mjs --stack",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check && npm test && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "deploy:staging": "CLOUDFLARE_ENV=staging npm run build && wrangler deploy --env staging",
    "deploy:prod": "CLOUDFLARE_ENV= npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.165.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/react": "^7.1.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "astro": "^7.4.1",
    "markdown-it": "^15.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
